<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/footSizeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dont_know_my_foot_shoe_size"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/footSizeEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/dont_know_my_foot_shoe_size_hint"
        app:layout_constraintTop_toBottomOf="@+id/footSizeTextView"
        app:layout_constraintStart_toStartOf="@+id/footSizeTextView"/>

    <Button
        android:id="@+id/footShoeAnswerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="@string/ok_button"
        app:layout_constraintTop_toBottomOf="@+id/footSizeEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/answerContainer"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/footShoeAnswerButton"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/footShoeSizeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Você tem 30,45cm de pé.\n1 pé possui 30,48cm.\nPortanto quantos pés você calça?" />

        <Button
            android:id="@+id/footAnswer1Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:text="1.1"
            app:layout_constraintTop_toBottomOf="@+id/footShoeSizeTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/footAnswer2Button"/>

        <Button
            android:id="@+id/footAnswer2Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1.2"
            app:layout_constraintTop_toBottomOf="@+id/footShoeSizeTextView"
            app:layout_constraintStart_toEndOf="@+id/footAnswer1Button"
            app:layout_constraintEnd_toStartOf="@+id/footAnswer3Button"/>

        <Button
            android:id="@+id/footAnswer3Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="0.85"
            app:layout_constraintTop_toBottomOf="@+id/footShoeSizeTextView"
            app:layout_constraintStart_toEndOf="@+id/footAnswer2Button"
            app:layout_constraintEnd_toStartOf="@+id/footAnswer4Button"/>

        <Button
            android:id="@+id/footAnswer4Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="3"
            app:layout_constraintTop_toBottomOf="@+id/footShoeSizeTextView"
            app:layout_constraintStart_toEndOf="@+id/footAnswer3Button"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/answerTimerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10,0"
            android:textSize="24sp"
            android:alpha="0.2"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/footAnswer4Button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>