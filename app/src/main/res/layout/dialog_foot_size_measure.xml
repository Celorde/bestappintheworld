<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditText
        android:id="@+id/footSizeEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/foot_size_hint_dialog"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/dontKnowMyFootButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dont_know_my_foot_button"
        app:layout_constraintTop_toBottomOf="@+id/footSizeEditText"
        app:layout_constraintStart_toStartOf="@+id/footSizeEditText" />

</androidx.constraintlayout.widget.ConstraintLayout>