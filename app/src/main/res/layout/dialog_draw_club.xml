<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <EditText
        android:id="@+id/clubEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:importantForAutofill="no"
        android:textSize="20sp"
        android:hint="@string/heart_club_hint"
        android:cursorVisible="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="LabelFor,TextFields" />

    <com.example.bestuiintheworld.ui.DrawingView
        android:id="@+id/clubDrawingView"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/clubEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/drawInfoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:textSize="18sp"
        android:text="Desenhe o escudo do seu Clube"
        app:layout_constraintTop_toBottomOf="@+id/clubDrawingView"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/eraseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Apagar"
        app:layout_constraintTop_toBottomOf="@+id/drawInfoTextView"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/selectColorButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="Cor"
        app:layout_constraintTop_toBottomOf="@+id/drawInfoTextView"
        app:layout_constraintEnd_toStartOf="@+id/eraseButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>