<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/insertAddressCodeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_address_code"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertAddressCodeEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_address_code_hint"
        android:focusable="false"
        android:cursorVisible="false"
        android:inputType="none"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertAddressCodeTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/applyAddressCodeDigitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@+id/insertAddressCodeEditText"
        app:layout_constraintStart_toEndOf="@+id/doNotKnowAdressCodeTextView"/>

    <TextView
        android:id="@+id/doNotKnowAdressCodeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/do_not_know_address_code_link"
        android:textSize="16sp"
        android:textColor="#36b4f7"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/applyAddressCodeDigitButton"
        app:layout_constraintBottom_toBottomOf="@+id/applyAddressCodeDigitButton"/>

    <TextView
        android:id="@+id/insertStateTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_state"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/doNotKnowAdressCodeTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertStateEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_state_hint"
        android:focusable="false"
        android:cursorVisible="false"
        android:inputType="none"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertStateTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/insertCityTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_city"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertStateEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertCityEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_city_hint"
        android:focusable="false"
        android:cursorVisible="false"
        android:inputType="none"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertCityTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/insertNeighborhoodTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_neighborhood"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertCityEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertNeighborhoodEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_neighborhood_hint"
        android:inputType="text"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertNeighborhoodTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/insertStreetTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_address"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertNeighborhoodEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertStreetEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_address_hint"
        android:focusable="false"
        android:cursorVisible="false"
        android:inputType="none"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertStreetTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/insertNumberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_number"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertStreetEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertNumberEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_number_hint"
        android:focusable="false"
        android:cursorVisible="false"
        android:inputType="none"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertNumberTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/insertComplementTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_complement"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertNumberEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertComplementEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_complement_hint"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertComplementTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/insertReferencePointTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_reference_point"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertComplementEditText"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertReferencePointEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_reference_point_hint"
        android:focusable="false"
        android:cursorVisible="false"
        android:inputType="none"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertReferencePointTextView"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>