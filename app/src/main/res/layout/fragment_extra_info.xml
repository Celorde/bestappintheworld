<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/insertStreamerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insert_streamer"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/insertStreamerEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/insert_streamer_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/insertStreamerTextView"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/insertFavoriteColorTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insert_favorite_color"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/insertStreamerEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/insertFavoriteColorEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/insert_favorite_color_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/insertFavoriteColorTextView"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/confirmFavoriteColorTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_favorite_color"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/insertFavoriteColorEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/confirmFavoriteColorEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/confirm_favorite_color_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/confirmFavoriteColorTextView"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/heartClubTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heart_club"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/confirmFavoriteColorEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/heartClubEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/heart_club_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/heartClubTextView"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/favoritePlateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorite_plate"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/heartClubEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/favoritePlateEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/favorite_plate_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/favoritePlateTextView"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/favoriteDishTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorite_dish"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/favoritePlateEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/favoriteDishEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/favorite_dish_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/favoriteDishTextView"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/footSizeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/foot_size"
            android:textSize="24sp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/favoriteDishEditText"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/footSizeEditText"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:hint="@string/foot_size_hint"
            android:focusable="false"
            android:cursorVisible="false"
            android:inputType="none"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/footSizeTextView"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>