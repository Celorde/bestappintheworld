<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/insertPasswordTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_password"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertPasswordEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:hint="@string/insert_password_hint"
        android:inputType="text"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertPasswordTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/wrongPasswordTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:textColor="#FF5555"
        app:layout_constraintTop_toBottomOf="@+id/insertPasswordEditText"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Deve possuir um emoji"/>

</androidx.constraintlayout.widget.ConstraintLayout>