<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/insertPasswordTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_password"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/insertPasswordEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:paddingEnd="48dp"
        android:textSize="20sp"
        android:hint="@string/insert_password_hint"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertPasswordTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/showHidePasswordButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_password_hide"
        app:layout_constraintTop_toTopOf="@+id/insertPasswordEditText"
        app:layout_constraintBottom_toBottomOf="@+id/insertPasswordEditText"
        app:layout_constraintEnd_toEndOf="@+id/insertPasswordEditText" />

    <TextView
        android:id="@+id/wrongPasswordTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:textColor="#FF5555"
        app:layout_constraintTop_toBottomOf="@+id/insertPasswordEditText"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Deve possuir um emoji"/>

    <TextView
        android:id="@+id/eyeEasterEggTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:textColor="#FFFFFF"
        android:alpha="0.025"
        android:text="olho"
        app:layout_constraintTop_toTopOf="@+id/insertPasswordEditText"
        app:layout_constraintBottom_toBottomOf="@+id/insertPasswordEditText"
        app:layout_constraintStart_toEndOf="@+id/showHidePasswordButton" />

    <TextView
        android:id="@+id/insertPasswordConfirmationTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/insert_password_confirmation"
        android:textSize="24sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/wrongPasswordTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.bestappintheworld.ui.CustomEditText
        android:id="@+id/insertPasswordConfirmationEditText"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:paddingEnd="48dp"
        android:textSize="20sp"
        android:hint="@string/insert_password_hint"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/insertPasswordConfirmationTextView"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/showHidePasswordConfirmationButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_password_hide"
        app:layout_constraintTop_toTopOf="@+id/insertPasswordConfirmationEditText"
        app:layout_constraintBottom_toBottomOf="@+id/insertPasswordConfirmationEditText"
        app:layout_constraintEnd_toEndOf="@+id/insertPasswordConfirmationEditText" />

    <TextView
        android:id="@+id/wrongPasswordConfirmationTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:textColor="#FF5555"
        app:layout_constraintTop_toBottomOf="@+id/insertPasswordConfirmationEditText"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Deve possuir um emoji"/>

</androidx.constraintlayout.widget.ConstraintLayout>