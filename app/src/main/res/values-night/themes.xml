<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark application theme. -->
    <style name="Theme.BestAppInTheWorld" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Status bar and Window color. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Typography & Text Appearance -->
        <item name="android:textColorPrimary">@color/on_background</item>
        <item name="android:textColorSecondary">@color/on_background</item>
        <item name="android:editTextColor">@color/on_background</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <item name="android:textViewStyle">@style/Widget.BestAppInTheWorld.TextView</item>
        <item name="editTextStyle">@style/Widget.BestAppInTheWorld.EditText</item>
        <item name="materialButtonStyle">@style/Widget.BestAppInTheWorld.Button</item>
    </style>
</resources>
